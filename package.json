{
  "name": "taskops-ticketing-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev -w @taskops/frontend",
    "dev:frontend": "npm run dev -w @taskops/frontend",
    "dev:backend": "npm run dev -w @taskops/backend",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "preview": "npm run preview -w @taskops/frontend",
    "start:backend": "npm run start -w @taskops/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prisma": "^7.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "@clerk/react": "^6.13.0",
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
